config_version=5

[application]

config/name="FarFromHuman"
run/main_scene="uid://fdya7vaypamp"
config/features=PackedStringArray("4.7", "Forward Plus")
config/icon="res://Textures/icon.svg"

[autoload]

PhantomCameraManager="*uid://duq6jhf6unyis"
Inventory="*uid://c4aeuw5x0ql0g"

[debug]

